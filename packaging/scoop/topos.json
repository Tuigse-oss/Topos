{
    "version": "{{VERSION}}",
    "description": "Free, open-source disk-space treemap visualizer for Windows 10 and 11.",
    "homepage": "https://github.com/Tuigse-oss/Topos",
    "license": "MIT|Apache-2.0",
    "notes": "Settings and each drive's last scan are kept in %LOCALAPPDATA%\\Topos and survive uninstalling.",
    "architecture": {
        "64bit": {
            "url": "{{X64_ZIP_URL}}",
            "hash": "{{X64_ZIP_SHA256}}"
        },
        "32bit": {
            "url": "{{X86_ZIP_URL}}",
            "hash": "{{X86_ZIP_SHA256}}"
        }
    },
    "bin": "Topos.exe",
    "shortcuts": [
        [
            "Topos.exe",
            "Topos"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Tuigse-oss/Topos/releases/download/v$version/Topos-v$version-x86_64-windows.zip"
            },
            "32bit": {
                "url": "https://github.com/Tuigse-oss/Topos/releases/download/v$version/Topos-v$version-x86-windows.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
